# ainterior backend :: environment
# Copy to .env.local (Next.js) and/or supabase/.env (edge functions).
# Nothing here is required for the offline demo except the Supabase URL/keys:
# RECON_PROVIDER defaults to mock, which needs NO API KEY (SPEC §5.5).

# ---------------------------------------------------------------- Supabase
# Project REST URL, e.g. https://abcdefgh.supabase.co (or http://127.0.0.1:54321 locally)
SUPABASE_URL=
# Public anon key. Safe in the browser; RLS is what protects the data.
SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Bypasses RLS. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Project JWT secret. Used to sign the short-lived phone capture tokens.
# Dashboard -> Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# Browser-visible mirrors (Next.js requires the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# edge  -> call Supabase Edge Functions directly
# local -> call the Next.js route handlers in apps/web/app/api (default for dev)
NEXT_PUBLIC_API_MODE=local
NEXT_PUBLIC_API_BASE=/api

# ---------------------------------------------------------------- app
# Base URL embedded in the capture QR code: {PUBLIC_APP_URL}/capture/{code}
PUBLIC_APP_URL=http://localhost:3000
# CORS origin for the edge functions ('*' in dev, your domain in production)
ALLOWED_ORIGIN=*

# ---------------------------------------------------------------- storage buckets
SCANS_BUCKET=scans
USER_ITEMS_BUCKET=user-items
RENDERS_BUCKET=renders

# ---------------------------------------------------------------- reconstruction
# mock  -> fully functional offline provider, timer-driven, no key needed (DEFAULT)
# meshy -> real Meshy.ai; requires MESHY_API_KEY
RECON_PROVIDER=mock
MESHY_API_KEY=
MESHY_API_BASE=https://api.meshy.ai
# How a Meshy mesh becomes a Room: bbox -> derive a rectangular shell from the
# mesh bounding box; raw -> return mesh_url + dims_mm only.
RECON_ROOM_FIT=bbox
# Meshy cannot read blueprints; delegate that one call to the mock provider.
RECON_BLUEPRINT_PROVIDER=mock
# Mock job duration in ms (how long a fake reconstruction takes)
RECON_MOCK_DURATION_MS=6000
# Mock failure probability 0..1 — set > 0 to exercise the refund path
RECON_MOCK_FAIL_RATE=0
# Credits deducted per recon job (SPEC §6: deducted on job creation only)
RECON_CREDIT_COST=1
# Shared fallback secret for provider webhooks. Per-job secrets are preferred and
# are generated automatically in create_recon_job().
RECON_WEBHOOK_SECRET=

# ---------------------------------------------------------------- vision / dedupe
# SPEC §5.4: at or above this cosine similarity we block 3D generation and
# spend NO credit. Do not raise without product sign-off.
DEDUPE_THRESHOLD=0.86
# Similarity floor for matches merely *shown* in the UI
MATCH_RETURN_FLOOR=0.45
# SPEC §5.4 cluster promotion
CLUSTER_THRESHOLD=0.9
MATCH_PROMOTION_THRESHOLD=5
# local (deterministic offline descriptor, default) | remote (hosted encoder)
VISION_EMBEDDER=local
VISION_LABELER=local

# ---------------------------------------------------------------- capture sessions
# SPEC §6: TTL 15 minutes, max 40 assets. These are ceilings, not suggestions —
# the database clamps them in create_capture_session() and trg_scan_assets_guard.
CAPTURE_SESSION_TTL_MINUTES=15
CAPTURE_SESSION_MAX_ASSETS=40
